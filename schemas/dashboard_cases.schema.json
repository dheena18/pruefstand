{
  "$defs": {
    "Category": {
      "description": "Kind of test case.",
      "enum": [
        "factual",
        "multi_hop",
        "comparison",
        "unanswerable",
        "cross_lingual",
        "injection",
        "leak_probe",
        "system_prompt_extraction",
        "filter_bypass"
      ],
      "title": "Category",
      "type": "string"
    },
    "DashboardCase": {
      "additionalProperties": false,
      "description": "Per-case fields of the cases list and the case page (sanitised, no chunk text).\n\nAttributes:\n    citations: From the response, canaries masked.\n    retrieved_chunk_tenant_ids: Parallel to ``retrieved_chunk_ids``; ``\"\"`` when the target\n        did not report a chunk's tenant.\n    error: The error class only (``TimeoutError``, ``TargetError``, ...), never its message.\n    failing: In ``GateReport.top_failing_cases`` or named by a hard fail.",
      "properties": {
        "answer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Answer"
        },
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/Category"
        },
        "citations": {
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "expect_refusal": {
          "title": "Expect Refusal",
          "type": "boolean"
        },
        "failing": {
          "title": "Failing",
          "type": "boolean"
        },
        "lang": {
          "$ref": "#/$defs/Lang"
        },
        "metric_status": {
          "additionalProperties": {
            "$ref": "#/$defs/MetricStatus"
          },
          "title": "Metric Status",
          "type": "object"
        },
        "metric_values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Metric Values",
          "type": "object"
        },
        "perturbation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Perturbation"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "refused": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Refused"
        },
        "retrieved_chunk_ids": {
          "items": {
            "type": "string"
          },
          "title": "Retrieved Chunk Ids",
          "type": "array"
        },
        "retrieved_chunk_tenant_ids": {
          "items": {
            "type": "string"
          },
          "title": "Retrieved Chunk Tenant Ids",
          "type": "array"
        },
        "tenant": {
          "title": "Tenant",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "tenant",
        "lang",
        "category",
        "perturbation",
        "question",
        "answer",
        "expect_refusal",
        "refused",
        "citations",
        "retrieved_chunk_ids",
        "retrieved_chunk_tenant_ids",
        "error",
        "metric_values",
        "metric_status",
        "failing"
      ],
      "title": "DashboardCase",
      "type": "object"
    },
    "Lang": {
      "description": "Language of a question or chunk.",
      "enum": [
        "de",
        "en"
      ],
      "title": "Lang",
      "type": "string"
    },
    "MetricStatus": {
      "description": "Outcome of computing one metric on one case.",
      "enum": [
        "ok",
        "not_applicable",
        "error"
      ],
      "title": "MetricStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "``cases/<run_id>/<shard>.json``: at most ``MAX_SHARD_CASES`` cases, shard 0 first.",
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/DashboardCase"
      },
      "title": "Cases",
      "type": "array"
    },
    "n_shards": {
      "title": "N Shards",
      "type": "integer"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "shard": {
      "title": "Shard",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "shard",
    "n_shards",
    "cases"
  ],
  "title": "DashboardCases",
  "type": "object"
}
