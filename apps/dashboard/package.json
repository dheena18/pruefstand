{
  "name": "@pruefstand/dashboard",
  "version": "0.0.1",
  "private": true,
  "description": "Static Next.js dashboard: renders the exported run artefacts (run.json, gate.json, cases), computes nothing.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node ../../scripts/dashboard/build.mjs",
    "gen:types": "node scripts/gen-types.mjs",
    "gen:licences": "node ../../scripts/dashboard/gen_licences.mjs",
    "gen:report-tokens": "node ../../scripts/dashboard/tokens_to_report.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.4",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.12",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.28",
    "jsdom": "26.1.0",
    "json-schema-to-typescript": "16.0.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.32",
      "@typescript-eslint/typescript-estree>minimatch": "11.0.1"
    }
  }
}
