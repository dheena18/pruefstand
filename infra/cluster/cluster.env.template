# Expected values for the ONE Ollama server on the cluster (ADR-0018, ADR-0019; setup log section 7) and the
# paths of the cluster scripts. The source of record for the server is the owner's ~/start-ollama.sh: status.sh
# only COMPARES the running server's environment (from /proc/<pid>/environ) with these values and warns on a
# difference; nothing here is ever exported to the server. deploy-cluster-bin.sh renders this file to
# /data/dheena/pruefstand-bin/cluster.env (listed in SHA256SUMS). Format: KEY=VALUE only, no quotes, no
# spaces; a value may start with $HOME. Names verified against Ollama 0.32 (docs/engineering/gpu-cluster.md).
CUDA_VISIBLE_DEVICES=0,1
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODELS=/data/dheena/Models
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=3
OLLAMA_KEEP_ALIVE=24h
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_NOPRUNE=1
# Paths and limits of the Pruefstand scripts (not part of the server environment).
OLLAMA_START_SCRIPT=$HOME/start-ollama.sh
OLLAMA_LOG=/data/dheena/ollama.log
MODELS_MIN_FREE_GB=2
GENERATOR_TAG=qwen3.8:27b-q8_0
