# Persistent GitHub Actions runner of the PRIVATE executor repo only (T6.2a S9; D100, D211, A13-M9, ADR-0019).
# System unit as user pruefstand; no storage/mount dependency (the data root is a plain directory: an unusable one
# fails the job in the preflight). ExecStart is the runner's own run.sh, which restarts the listener after a
# self-update (auto-update stays on). <runner-dir> is set by the owner at install time.
[Unit]
Description=Pruefstand gate executor runner (private repo)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
User=pruefstand
Group=pruefstand
WorkingDirectory=/home/pruefstand/pruefstand/runner
# Executor settings and secrets (D1091): read by systemd's EnvironmentFile= rules, never by bash `source`:
# one KEY=VALUE per line, no `export`, no $VAR expansion or command substitution, quotes only around a whole value.
EnvironmentFile=/home/pruefstand/runner.env
ExecStart=/home/pruefstand/pruefstand/runner/run.sh
Restart=always
RestartSec=10
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=5min
# No NoNewPrivileges= (and no directive that implies it, systemd.exec(5)): the preflight repairs the tunnel
# with `sudo -n systemctl restart pruefstand-tunnel` (the one sudoers rule), which no_new_privs would block
# (D1096, review #202; test_host_privileges.py). pruefstand is in group docker anyway (root-equivalent).

[Install]
WantedBy=multi-user.target
