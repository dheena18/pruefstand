# T0.4: assembled Pages site (scripts/deploy/assemble_pages_site.sh)
_pages/

# T1.6: mutmut working copy
mutants/

# T1.13: the slice corpus is the only committed corpus
!corpus/slice_v1/

# T4.1: dry-run HF export layout (D9-33)
**/hf_export/

# T8.1: dashboard fixture sets hold runs/ directories (real run dirs and the exported data trees)
!apps/dashboard/fixtures/**/runs/
# T8.1: dashboard sources and tests live in directories the patterns above would hide
!apps/dashboard/test/build/
!apps/dashboard/src/app/**/runs/
# T2.6: draft private documents (reviewed, then moved to datasets/private_docs/<tenant>/)
datasets/private_docs/_drafts/

# T4.2: QA generation work dirs (candidates, ledger, cross-check; regenerated)
datasets/_work/
