# .env.example — every environment variable of the project, grouped by machine.
# The single reference (where each value lives, who creates it, scopes, rotation) is docs/ops/secrets.md.
# Rules: no real values are committed; only safe defaults appear below. GitHub App keys, PATs and
# HELDOUT_SEED are GitHub repo/environment secrets and NEVER go into any .env file. No password is
# stored anywhere (round 10 Z7). Machines: round 10 Z1 / Z7; VM identities: round 11 Y1 (D211–D214; proxy networking D242);
# round 12: D252 (llm-proxy options), D262 (demo test reset), D272 (catalogue path), D279 (CLUSTER block is
# documentation only); round 13: D287 (gate-router App key = public environment secret, never here), D299 (nightly
# counter), D303 (reset called inside the container), D310 (compose rule, supersedes D278), D316 (new rows).
#
# Which file gets which section (round 11, DEV11-18):
#   * Owner's `.env` on the VM (`~/code/pruefstand/.env`, git-ignored; the lead agent copies or symlinks it into
#     every worktree, D234) = LOCAL + VM-SHARED. No key appears twice; PRUEFSTAND_STACK=live, PORT_OFFSET=10000.
#   * Executor env `/home/pruefstand/runner.env` (owner `pruefstand`, mode 600; T6.2a) = VM-SHARED + VM-EXECUTOR.
#     Executor secrets live ONLY there (D213); coding agents never read /home/pruefstand/** or /var/lib/pruefstand/**.
#   * `$CLUSTER_NAS_ROOT/bin/cluster.env` = CLUSTER, generated by T3.1a from infra/cluster/cluster.env.template (D231);
#     the CLUSTER block below is documentation only (all lines commented): the template is the single source (D279).
#   * WSL2 / laptop (optional) = LOCAL only (PRUEFSTAND_DATA_ROOT a local dir, own tunnel for the Ollama URLs).

# =====================================================================================================
# LOCAL — development shell. Main dev machine = the TrueNAS VM `pruefstand-exec` (owner login user), opened
# from VS Code on Windows via Remote-SSH (round 10 Z7). WSL2 on the laptop is an optional alternative.
# =====================================================================================================

# GitHub owner (user or org) of the public repo and the private executor repo
GH_OWNER=
# Hugging Face user/org that owns the dataset repo <HF_USER>/pruefstand-de
HF_USER=
# Hugging Face fine-grained token: read (needed for gated Llama/Gemma weights; accept each model's licence on its HF page first); write only on <HF_USER>/pruefstand-de for the manual T4.7b push. PruefstandSettings also reads it as PRUEFSTAND_HF_TOKEN (alias; HF_TOKEN wins if both are set)
HF_TOKEN=
# GitHub fine-grained PAT with only "Models: read" — local live tests and cassette recording; local only, never a repo secret (CI uses the workflow GITHUB_TOKEN)
# (The owner's gh/git token on the VM is NOT an env var: a separate fine-grained PAT limited to the public repo, stored by
# `gh auth login --with-token`; never `gh auth login --web`; docs/ops/secrets.md, D257)
GITHUB_TOKEN=
# GitHub Models model id used by the optional live client test (T1.4) and the tier-1 judge (T5.4 pins it)
PRUEFSTAND_GH_MODELS_MODEL=
# Owner's host state dir (runs, local caches). NOT the executor's (that is /home/pruefstand/pruefstand) and NOT the lock dir
PRUEFSTAND_HOME=~/pruefstand
# Which stack `pruefstand run` targets: live (CPU compose, tier-1 shape) | a40 (tier 2 via the VM tunnels; executor only)
PRUEFSTAND_STACK=live
# Shared-cache mode for runs: overlay (default, PR-like) | shared (main/nightly only)
PRUEFSTAND_CACHE_MODE=overlay
# Local cache dir of PruefstandSettings (T1.2); empty = $PRUEFSTAND_HOME/cache
PRUEFSTAND_CACHE_DIR=
# JSON logs (structlog); CI sets true; empty = auto (true when CI is set)
PRUEFSTAND_LOG_JSON=
# Set to "skipped" to run without any judge (forks do this in CI); unset = automatic
PRUEFSTAND_JUDGE_MODE=
# Simulation grid for `make test-slow`: reduced (default) | full (4 000 sims, nightly)
PRUEFSTAND_SIM_GRID=reduced
# Pseudonymous annotator id for optional human labels (T5.3-opt); no personal data
PRUEFSTAND_ANNOTATOR=
# Bug-switch scenario of the tier-1 e2e job (T1.11/T1.12); set per matrix job by live-e2e.yml; empty = correct config
PRUEFSTAND_E2E_SCENARIO=
# Path of the GPU endpoint map read by build_backend (T1.2/T5.1); relative to the working directory
PRUEFSTAND_GPU_ENDPOINTS=infra/gpu/endpoints.yaml
# Path of the model catalogue (per-model options + option_bounds) read by LiteLLMBackend at request time (T1.2 field, T5.1; D272)
PRUEFSTAND_GPU_CATALOGUE=infra/gpu/models.yaml

# --- local services (compose profiles core/live/dev, all bound to 127.0.0.1) ---
# Host-port offset of the compose stack (T0.3, D214): 0 on a laptop/WSL; 10000 on the VM so the owner/agent dev stack
# (profile dev: Qdrant 16333/16334, rerank 18201, rag-demo 18000, llm-proxy 21500) never clashes with the executor's
# default ports. Do NOT set the per-service ports here: make (mk/docker.mk, T0.3) exports QDRANT_HTTP_PORT,
# QDRANT_GRPC_PORT, LLM_HOST_PORT, EMBED_HOST_PORT, RAG_DEMO_HOST_PORT, RERANK_HOST_PORT, LLM_PROXY_PORT
# = default + PORT_OFFSET for every compose call (`make -s ports` prints them; D214, D247). On the VM prefer
# `make up PROFILES="core live dev"`; a raw `docker compose` is safe only after `make ports-env` has appended those
# *_PORT keys to this (owner's) .env, verified by `make check-ports` (D310); they never go into runner.env
PORT_OFFSET=0
# Compose project name: empty on a laptop; pruefstand-dev in the owner's .env on the VM (never the executor's pruefstand-exec)
COMPOSE_PROJECT_NAME=
# rag-demo target API (compose `rag-demo`); on the VM with PORT_OFFSET=10000: http://localhost:18000
PRUEFSTAND_TARGET_URL=http://localhost:8000
# llama.cpp CPU server (compose `llm`) used by live tests (T1.4)
PRUEFSTAND_TEST_LLM_URL=http://localhost:8080/v1
# Base URL for `openai_compatible_local/` model ids (T1.4 factory); tier 1 has no CPU judge service
PRUEFSTAND_JUDGE_BASE_URL=http://localhost:8080/v1
# Optional: datagen endpoint for cassette recording of T4.2 (an Ollama URL from VM-SHARED); empty = skip
PRUEFSTAND_DATAGEN_URL=
# rag-demo profile file (tier 1 CPU); rag.gpu.yaml = tier 2, rag.public.yaml = public demo (T8.4)
RAG_CONFIG=apps/rag-demo/configs/rag.yaml
# Model catalogue rag-demo reads to resolve catalogue_id (T3.2); baked into the image at the same path
RAG_MODEL_CATALOGUE=infra/gpu/models.yaml
# Directory with the pinned CPU GGUF/embedding files (filled by scripts/models/fetch.py, read-only in compose)
LIVE_MODEL_DIR=~/.cache/pruefstand/models
# GGUF file name inside LIVE_MODEL_DIR served by compose `llm` (default: pinned file from infra/models/*.yaml)
LIVE_LLM_GGUF=
# CPU threads for the llama.cpp server
LIVE_LLM_THREADS=4
# Optional OTLP endpoint for traces (ADR-0013); empty = no export
OTEL_EXPORTER_OTLP_ENDPOINT=
# Dashboard build: data tree to build from (T8.1), e.g. apps/dashboard/fixtures/populated
DASHBOARD_DATA_DIR=
# Dashboard basePath: empty locally; deploy.yml builds with /pruefstand (Pages site root, D243)
NEXT_BASE_PATH=
# Workflow/Make-only (never needed in .env; listed for completeness, D316): PAGES_MAX_BYTES (Pages size cap, default
# 800000000, T0.4), BUILD_ID ("<head_sha>-<deploy_run_id>", docs.yml deploy job, D304), HYPOTHESIS_PROFILE (ci | nightly,
# T0.1), LITELLM_LOCAL_MODEL_COST_MAP (True, exported by make test/coverage)
# HYPOTHESIS_PROFILE=ci

# --- optional public demo API (T8.4; `make rag-demo-up PUBLIC=1`; hosted on the VM behind a Cloudflare Tunnel, D239) ---
# Master switch of the public /v1/query demo mode
DEMO_ENABLED=false
# Requests per minute per client key
DEMO_RATE_PER_MIN=10
# Requests per day per client key
DEMO_DAILY_PER_KEY=100
# Global daily token budget (generator tokens); empty = T8.4 default
DEMO_DAILY_TOKENS=
# Global daily request budget; empty = T8.4 default
DEMO_DAILY_REQUESTS=
# Max concurrent generations
DEMO_MAX_CONCURRENCY=
# Server-side request timeout in seconds; must stay below NEXT_PUBLIC_DEMO_TIMEOUT_S
DEMO_TIMEOUT_S=75
# Exact CORS origin of the dashboard (the GitHub Pages origin, e.g. https://dheena18.github.io)
DEMO_ALLOWED_ORIGIN=
# Number of trusted reverse-proxy hops for client IPs (1 behind the Cloudflare Tunnel; 0 for the rag-demo-e2e test instance)
TRUSTED_PROXY_HOPS=
# Test-only reset endpoint POST /v1/_test/reset (loopback only) — set to 1 ONLY in the env of the rag-demo-e2e
# instance started by try_e2e.sh (T8.4, D262); never in the demo env or any .env. Called from inside the container
# (`docker compose exec rag-demo-e2e curl -X POST localhost:8000/v1/_test/reset`, D303); E2E_PORT is computed by try_e2e.sh
# DEMO_TEST_RESET=1
# Dashboard: URL of the demo API; empty = "try it" panel hidden. deploy.yml takes it from the public repo VARIABLE
# DEMO_API_URL (vars.DEMO_API_URL, not a secret; UI12-19)
NEXT_PUBLIC_DEMO_API_URL=
# Dashboard: client-side timeout in seconds for the demo call
NEXT_PUBLIC_DEMO_TIMEOUT_S=90
# Cloudflare Tunnel token for the optional demo (D239, D244) — secret, lives ONLY in /home/pruefstand/demo.env
# (mode 600, user pruefstand), read by the cloudflared container the private nightly demo-deploy job starts; never here
# CLOUDFLARE_TUNNEL_TOKEN=

# =====================================================================================================
# VM-SHARED — host facts of `pruefstand-exec` used by both the owner's .env and the executor's runner.env.
# The cluster SSH key belongs to system user `pruefstand` only (/home/pruefstand/.ssh/id_ed25519_cluster,
# created in T0.7 as `pruefstand`; the cluster password is typed once and never stored); never in this file.
# The GPU lock is the fixed file /var/lib/pruefstand/gpu.lock and MAINTENANCE the fixed file
# /var/lib/pruefstand/MAINTENANCE (D211/D212): neither is a variable.
# =====================================================================================================

# SSH host alias of the GPU cluster (resolved through /home/pruefstand/.ssh/config)
CLUSTER_SSH_HOST=cairo-s101lp
# NAS dataset root as the cluster sees it (cluster scripts and cluster.env live in $CLUSTER_NAS_ROOT/bin/)
CLUSTER_NAS_ROOT=/data/dheena/truenas-ollama
# Same NAS dataset as the VM sees it (systemd automount unit, D227): data/, corpus/, datasets/, baselines/, backups/, cache/
PRUEFSTAND_DATA_ROOT=/mnt/pruefstand
# Generator lane (generator + embeddings; llama 70B in datagen) through the autossh tunnel (pruefstand-tunnel.service);
# native /api/* only. ADR-0018: ONE Ollama server on the cluster serves both GPUs, so both URLs are the same tunnel end
OLLAMA_GPU0_URL=http://127.0.0.1:11434
# Judge lane (PR judge by day, nightly judge by night): the same server as OLLAMA_GPU0_URL (ADR-0018); kept as its own
# setting so a later split is a .env change only
OLLAMA_GPU1_URL=http://127.0.0.1:11434
# flock -w timeout in seconds for pruefstand-lock and the lock-taking mk/gpu.mk targets (T0.7, T3.1a)
GPU_LOCK_TIMEOUT_S=7200

# =====================================================================================================
# VM-EXECUTOR — only in /home/pruefstand/runner.env (owner pruefstand, mode 600; T6.2a). Read by
# pruefstand-runner.service and the orchestrator. Never in the owner's .env.
# =====================================================================================================

# Executor state dir on the VM-local disk: state/, runs/, caches, Qdrant data (never on the NAS, round 10 Z5)
PRUEFSTAND_HOME=/home/pruefstand/pruefstand
# Stack for executor runs
PRUEFSTAND_STACK=a40
# CPU reranker on the internal candidate network (no host port in the executor stack; no auth, D217)
RERANK_URL=http://rerank-cpu:8201
# Trusted llm-proxy (normal container on gate-net + proxy-egress, D242); passed by the orchestrator into the candidate env
LLM_PROXY_URL=http://llm-proxy:11500
# llm-proxy's only upstream: the Ollama tunnel on the Docker bridge gateway, reached over proxy-egress (D242)
LLM_PROXY_UPSTREAM=http://172.17.0.1:11434
# Bearer key rag-demo sends to llm-proxy on every generator and embedding call (D216); `openssl rand -hex 32`
PRUEFSTAND_CANDIDATE_API_KEY=
# Directory with the held-out canary registry (private repo checkout); set only for trusted jobs, never passed to a candidate
PRUEFSTAND_HELDOUT_DIR=
# Random 32-byte hex key for judge-prompt nonces (T5.2a); generate on the VM (`openssl rand -hex 32`)
PRUEFSTAND_NONCE_KEY=
# age PUBLIC key (age1…) the weekly backup is encrypted to; the private key stays on the owner's laptop
AGE_RECIPIENT=
# GitHub owner of both repos (same value as LOCAL)
GH_OWNER=
# Set by pruefstand-lock / the orchestrator after taking gpu.lock; never set it in any .env (X2.1)
# PRUEFSTAND_LOCK_HELD=1
# Path of the counter file; unset -> $PRUEFSTAND_HOME/state/nightly_counter (the executor's copy of state/nightly_counter
# on branch executor-state; one name, D322); read by `pruefstand run --block auto` (k = value mod 3; file missing -> 0,
# invalid -> exit 2), incremented
# only by T6.2b after a completed nightly (R13 P4.4, D299)
# PRUEFSTAND_NIGHTLY_COUNTER=
# Trusted main checkout that health.sh exit 14 compares NAS bin/ against; default = the runner's checkout of main (T3.1a)
# PRUEFSTAND_TRUSTED_CHECKOUT=
# The pruefstand-bot App key (BOT_APP_ID/BOT_APP_KEY) is a private-repo secret and a public secret in environment
# gate-router (D287); it never goes into any .env

# =====================================================================================================
# CLUSTER — `cairo-s101lp`, runs only ONE Ollama server for both GPUs (ADR-0018; the existing server is reused, else
# started with setsid nohup, D228; no tmux, no Docker, no systemd linger). DOCUMENTATION ONLY (R12 DEV12-10, D279):
# every line is commented out. The single source of these settings is infra/cluster/cluster.env.template (T3.1a),
# which deploy-cluster-bin.sh renders into $CLUSTER_NAS_ROOT/bin/cluster.env (checksummed in SHA256SUMS, D231). The
# names below are exactly the template's; values are the template's planning values (verify on the pinned Ollama in
# T3.1a). start-ollama.sh derives the NAS root from its own path and, only when no server answers on 127.0.0.1:11434,
# starts one with OLLAMA_MODELS=$NAS/ollama-models, OLLAMA_HOST=127.0.0.1:11434 and CUDA_VISIBLE_DEVICES=0,1; those
# three are fixed in the script and never in the template. Nothing is written outside the NAS mount.
# =====================================================================================================

# Parallel request slots per loaded model; server-wide (lowered to 2 before a judge's num_ctx is lowered, AI12-09)
# OLLAMA_NUM_PARALLEL=4
# Models kept loaded at once: generator + embeddings + one judge (ADR-0018)
# OLLAMA_MAX_LOADED_MODELS=3
# Server default keep-alive; preload uses the catalogue keep_alive, unload keep_alive 0 (D220, D252)
# OLLAMA_KEEP_ALIVE=24h
# Flash attention on
# OLLAMA_FLASH_ATTENTION=1
# KV cache type
# OLLAMA_KV_CACHE_TYPE=f16
# Shared NAS model store: never prune blobs on start
# OLLAMA_NOPRUNE=1
# Ollama binary (default: ollama on PATH)
# OLLAMA_BIN=ollama
